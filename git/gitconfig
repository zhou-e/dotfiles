# Identity (name/email) lives in ~/.gitconfig.local, which is untracked.
# See git/gitconfig.local.example.
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	autocrlf = input
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
